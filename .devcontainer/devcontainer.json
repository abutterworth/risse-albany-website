{
  "name": "RISSE website",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "Website preview",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "python scripts/build.py && python scripts/check.py"
}
